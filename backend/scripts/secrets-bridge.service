[Unit]
Description=GamCiv secrets bridge (writes .env.functions, reloads edge functions)
After=network.target docker.service
Wants=docker.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/supabase/docker/secrets_bridge.py
Restart=on-failure
RestartSec=3
# Runs as root: needs to edit /opt/supabase/docker/.env.functions and control docker.
User=root
# Hardening (keep root, but limit surface):
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=false
ReadWritePaths=/opt/supabase/docker
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
