# Environment for the GamCiv edge functions.
# Copy real values to /opt/supabase/docker/.env.functions on the VPS (chmod 600),
# which is wired into the functions container via env_file in docker-compose.yml.
# Compose restart/recreate picks changes up.

# --- GOWA (WhatsApp gateway) ---
# Public HTTPS base for GOWA REST (needs Basic auth). From the Supabase VPS use the
# tunnel hostname; from a box sharing GOWA's network you can use http://<ip>:3000.
GOWA_BASE_URL=https://gowa.quiz.gm
# Basic auth "user:pass" — sent as Authorization: Basic base64(user:pass)
GOWA_BASIC_AUTH=admin:CHANGE_ME
# Optional: only needed when more than one GOWA device is linked
# GOWA_DEVICE_ID=main

# --- Webhook HMAC (intake) ---
# Must match the per-device webhook_secret configured in GOWA.
GOWA_WEBHOOK_SECRET=CHANGE_ME

# --- notify-out auth (called by pg_net) ---
# Shared secret sent by the DB in the x-gamciv-key header. Generate: openssl rand -hex 24
INTERNAL_FUNCTION_KEY=CHANGE_ME

# --- AI classifier (OpenAI-compatible, plain fetch) ---
# Default targets Cloudflare Workers AI's OpenAI-compatible endpoint; swap freely.
AI_BASE_URL=https://api.cloudflare.com/client/v4/accounts/<account_id>/ai/v1
AI_API_KEY=CHANGE_ME
AI_MODEL=@cf/meta/llama-3.1-8b-instruct-fp8
# Optional per-call timeout (ms)
# AI_TIMEOUT_MS=15000
# Model for voice-note transcription (OpenAI-compatible /audio/transcriptions,
# with a Cloudflare-native whisper fallback for gateways without that route).
#AI_TRANSCRIBE_MODEL=whisper-1

# --- SMS fallback (optional; without it whatsapp-channel is the only delivery) ---
# TERMII_API_KEY=CHANGE_ME
# TERMII_SENDER_ID=GamCiv
# TERMII_ENDPOINT=https://api.ng.termii.com

# --- Telegram intake ---
# Bot token from @BotFather (step 1 of docs/telegram-golive.md). Until the real
# token is set, requests fail 500 and Telegram must NOT be wired up yet.
TELEGRAM_BOT_TOKEN=CHANGE_ME
# Secret Telegram echoes in the X-Telegram-Bot-Api-Secret-Token header of every
# delivery; generate with openssl rand -hex 24.
TELEGRAM_WEBHOOK_SECRET=CHANGE_ME

# --- Optional message-bridge service (not included; may be added later) ---
# When CHANNELS_URL is set, outbound sends (notify-out whatsapp, intake
# confirmations) are routed through the bridge's POST /send endpoint instead
# of direct provider calls. Unset = direct sends, fully backward compatible.
# The bridge service is not part of this repo; it would read its own env
# (TELEGRAM_BOT_TOKEN, WHATSAPP_BRIDGE_URL, WHATSAPP_ALLOW_FROM...).
# CHANNELS_URL=http://127.0.0.1:8811

# --- Telegram bot channel ---
TELEGRAM_BOT_TOKEN=CHANGE_ME
TELEGRAM_WEBHOOK_SECRET=CHANGE_ME

# --- Email (Resend) + GoTrue send-email hook ---
# Verify your sending domain at resend.com/domains first.
RESEND_API_KEY=CHANGE_ME
RESEND_FROM=GamCiv <noreply@your-domain>
# openssl rand -base64 24; prefix with "v1,whsec_"
SEND_EMAIL_HOOK_SECRET=v1,whsec_CHANGE_ME

# --- Optional message-bridge service (not included; may be added later) ---
# When CHANNELS_URL is set, sends route through the bridge; when unset,
# functions call GOWA / Telegram directly.
# CHANNELS_URL=http://your-channels-host:8080
