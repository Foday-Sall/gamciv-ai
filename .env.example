# ============================================================================
# GamCiv AI — messaging layer environment (PicoClaw + gowa-bridge + agent-api)
# Copy to .env on the target VPS, fill real values, then run
# scripts/deploy-messaging.sh. NEVER commit a filled copy.
# ============================================================================

# --- Supabase (edge functions runtime; agent-api reads these) ---------------
# Public HTTPS base of the self-hosted Supabase (functions route through Kong)
SUPABASE_URL=https://api.pocketsoftware.dev
# Service-role key (functions container provides this automatically on the VPS)
SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME

# --- agent-api edge function ------------------------------------------------
# Bearer key required by agent-api (PicoClaw MCP server + REST endpoints).
# Generate with: openssl rand -hex 24
AGENT_API_KEY=CHANGE_ME
# Optional: email confirmations via Resend (leave empty to disable)
RESEND_API_KEY=
RESEND_FROM=GamCiv <onboarding@resend.dev>

# --- GOWA (WhatsApp gateway) -------------------------------------------------
# Base URL of the GOWA REST API as reachable from the VPS host and containers
GOWA_BASE_URL=http://gowa:3000
# Basic auth "user:pass" — must match GOWA's APP_BASIC_AUTH
GOWA_BASIC_AUTH=admin:CHANGE_ME
# Optional: only when more than one GOWA device is linked
# GOWA_DEVICE_ID=main
# HMAC secret GOWA signs its webhooks with (whatsapp-intake + gowa-bridge)
GOWA_WEBHOOK_SECRET=CHANGE_ME

# --- gowa-bridge (WebSocket server for PicoClaw's WhatsApp channel) ---------
# Port PicoClaw dials (channel_list.whatsapp.settings.bridge_url)
GOWA_BRIDGE_PORT=3001

# --- PicoClaw ----------------------------------------------------------------
# Telegram bot used by PICOCLAW's Telegram channel (must be a bot whose token
# is NOT already polled by another process — one consumer per token).
PICOCLAW_TELEGRAM_BOT_TOKEN=CHANGE_ME
# Telegram user id(s) allowed to talk to the bot (allow_from)
PICOCLAW_TELEGRAM_ALLOW_FROM=CHANGE_ME
# WhatsApp sender JIDs allowed through the bridge (allow_from, e.g. 2201234567)
PICOCLAW_WHATSAPP_ALLOW_FROM=CHANGE_ME

# --- LLM (OpenAI-compatible endpoint used by PicoClaw) ----------------------
PICOCLAW_LLM_MODEL=@cf/zai-org/glm-5.3-flash
PICOCLAW_LLM_API_BASE=https://api.cloudflare.com/client/v4/<account_id>/ai/v1
PICOCLAW_LLM_API_KEY=CHANGE_ME
